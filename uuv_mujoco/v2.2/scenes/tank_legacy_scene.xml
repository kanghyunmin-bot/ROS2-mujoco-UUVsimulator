    <accelerometer name="imu_acc" site="imu_site" noise="0" />
    <velocimeter name="dvl_vel_body" site="dvl_site" noise="0" />
    <rangefinder name="dvl_altitude" site="dvl_site" cutoff="30" />
    <framepos name="depth_pos" objtype="site" objname="bar30_site" />
