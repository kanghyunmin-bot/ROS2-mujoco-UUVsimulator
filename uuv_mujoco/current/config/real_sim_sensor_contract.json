  "device_boundaries": {
    "fcu": {
      "transport": "serial_mavlink",
      "real_default": "/dev/ttyACM0:57600",
      "sim_provider": "ArduSub_SITL",
      "sim_plant_transport": "mandatory_400_hz_json_sample_hold_for_fcu_controller_only",
      "strict_sim_raw_topic_provider": "mujoco_bridge_delivery_driven_sensor_model",
      "strict_sim_public_raw_topics": [
        "/mavros/imu/data_raw",
        "/mavros/imu/static_pressure"
      ],
      "strict_sim_ahrs_topic_provider": "external_ardusub_mavros",
      "strict_sim_public_ahrs_topics": [
        "/mavros/imu/data"
      ],
      "strict_sim_mavros_passthrough_namespace": "/uuv_mujoco/mavros_fcu_passthrough",
      "hardware_model": null,
      "status": "model_unresolved"
    },
    "dvl": {
      "model": "Water Linked A50",
      "transport": "tcp_newline_json",
      "real_default_host": "192.168.194.95",
      "real_default_port": 16171,
      "sim_provider": "A50_protocol_emulator",
      "driver_package": "auv_dvl_a50",
      "message_package": "auv_dvl_a50_msg",
      "sim_modes": {
        "direct_ros": "bridge publishes DVL messages for diagnostics and legacy use",
        "tcp_driver": "bridge emulates the A50 TCP device and the unmodified physical driver owns ROS topics"
      },
      "default_sim_mode": {
        "strict_real_pkg_compat": "tcp_driver",
        "non_strict": "direct_ros"
      },
      "recommended_sim_to_real_mode": "tcp_driver",
      "tcp_driver_enable_environment": "ROS2_UUV_DVL_DEVICE_EMULATOR_ENABLE=1",
      "strict_direct_ros_opt_out_allowed": false,
      "official_operating_specification": {
        "transducer_beam_angle_deg": 22.5,
        "minimum_altitude_m": 0.05,
        "maximum_altitude_m": 50.0,
        "adaptive_ping_rate_range_hz": [4.0, 15.0],
        "source": "https://waterlinked.com/datasheets/dvl-a50"
      },
      "official_tcp_report_contract": {
        "velocity_report_rate": "adaptive_to_altitude_and_configuration",
        "dead_reckoning_expected_rate_hz": 5.0,
        "network_latency_ms": {
          "mean": 4.0,
          "standard_deviation": 2.0,
          "observed_maximum": 13.0,
          "hard_realtime_guarantee": false
        },
        "source": "https://docs.waterlinked.com/dvl/dvl-json-protocol/"
      },
      "local_rate_observation": {
        "bag": "bag_2026-04-01_20-08-11",
        "dvl_data_hz": 9.275646435125926,
        "dvl_position_hz": 4.413036175468005,
        "dvl_twist_hz": 8.946948401873865,
        "source": "document/docsource/bar30_z_check_20260504/bag_2026-04-01_20-08-11/summary.json"
      },
      "noise_parameter_policy": {
        "classification": "pre_bag_calibration_prior",
        "is_official_manufacturer_specification": false,
        "must_be_fitted_and_validated_with_real_bag_data": true,
        "note": "Any simulated bias, white-noise, random-walk, dropout, or correlation parameter is a modeling prior until it is fitted and validated against real sensor data."
      }
    },
    "hydrophone": {
      "transport": "alsa",
      "real_default": "hw:AMS22,0",
      "sample_rate_hz": 96000,
      "channels": 2,
      "sample_format": "S32LE"
    },
    "dronecan_battery": {
      "transport": "socketcan",
      "real_default": "can1",
      "target_node_id": 125,
      "sim_provider": "vcan_DroneCAN_emulator"
    },
    "realsense": {
      "hardware_model": null,
      "serial_number": null,
      "status": "model_and_serial_unresolved"
    },
    "imx219": {
      "hardware_model": "dual Raspberry Pi Camera Module v2 IMX219",
      "driver_package": "auv_imx219_camera",
      "transport": "dual_csi_gstreamer_image_transport",
      "default_resolution": [1280, 720],
      "default_rate_hz": 30.0,
      "raw_encoding": "bgr8",
      "compressed_format": "bgr8; jpeg compressed bgr8",
      "compressed_jpeg_quality": 95,
      "timestamp_source": "gstreamer_pts",
      "timestamp_fallback": "last_stamp_plus_frame_period_capped_by_ros_publish_time_with_throttled_warning_and_correction_count",
      "calibration_status": "physical_pair_measurement_required",
      "physical_calibration_launch_arguments": [
        "camera0_calibration_file",
        "camera1_calibration_file"
      ],
      "physical_calibration_policy": "supply_measured_in_water_camera_info_yaml_before_localization_or_slam_use",
      "physical_static_tf_enabled_by_default": false,
      "physical_static_tf_enable_argument": "publish_imx219_static_tf",
      "physical_extrinsic_policy": "measure_both_base_link_to_optical_transforms_and_supply_all_xyz_rpy_launch_arguments_before_localization_or_slam_use"
    },
    "ping360": {
      "hardware_driver_package": null,
      "status": "physical_driver_unresolved"
    }
