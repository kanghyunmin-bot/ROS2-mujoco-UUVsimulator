# Simulation-only controller tuning, not physical-vehicle calibration.
# Native SITL magnetometer; release braking enabled separately by the launcher.
COMPASS_ENABLE 1
COMPASS_USE 1
EK3_SRC1_YAW 1
EK3_SRC2_YAW 1
EK3_SRC3_YAW 1
ATC_RAT_YAW_P 0.7
ATC_RAT_YAW_I 0
ATC_RAT_YAW_IMAX 0.02
ATC_RAT_RLL_P 0.1
ATC_RAT_RLL_I 0.1
ATC_RAT_RLL_D 0.001
ATC_RAT_PIT_P 0.1
ATC_RAT_PIT_I 0.1
ATC_RAT_PIT_D 0.001
ATC_ANG_RLL_P 4.5
ATC_ANG_PIT_P 4.5
