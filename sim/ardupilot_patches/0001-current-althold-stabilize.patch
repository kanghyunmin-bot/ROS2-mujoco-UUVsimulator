\ No newline at end of file
+    // get_throttle_in_bidirectional() and throttle_vehicle_frame are in
+    // [-1, 1], while set_throttle() takes [0, 1].  Passing the rotated value
+    // straight to set_throttle() subtracts the neutral offset a second time:
+    // at level attitude a controller output of 0.67 became about 0.34 and
+    // reversed the ALT_HOLD correction.  Convert back to normalized throttle
+    // before adding the pilot's body-axis contribution at steep attitudes.
+    const float throttle_normalized = 0.5f + 0.5f * throttle_vehicle_frame.z
+        + raw_throttle_factor * (pilot_throttle_input - 0.5f);
+    motors.set_throttle(constrain_float(throttle_normalized, 0.0f, 1.0f));
+    motors.set_forward(-throttle_vehicle_frame.x + pilot_forward_input);
+    motors.set_lateral(-throttle_vehicle_frame.y + pilot_lateral_input);
+}
