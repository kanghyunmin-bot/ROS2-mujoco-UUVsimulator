+    const float pilot_forward_input = failsafe.pilot_input ? 0.0f : channel_forward->norm_input();
+    const float pilot_lateral_input = failsafe.pilot_input ? 0.0f : channel_lateral->norm_input();
+    const float pilot_throttle_input = failsafe.pilot_input ? 0.5f : channel_throttle->norm_input();
+    Vector3f earth_frame_rc_inputs = ahrs.get_rotation_body_to_ned() * Vector3f(
+        -pilot_forward_input,
+        -pilot_lateral_input,
+        2.0f * (-0.5f + pilot_throttle_input));
+
+    // earth_frame_rc_inputs.z is dimensionless, while the legacy expression
+    // passed 500 + PILOT_SPEED_UP*z to a helper that expects 0..1000 RC
+    // control units.  That mixed cm/s, PWM deadzone and control-input units,
+    // making small but valid ALT_HOLD heave commands disappear.  Apply the
