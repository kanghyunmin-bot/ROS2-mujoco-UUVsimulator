# The buoy detector weight is required at runtime but is too large for normal
# Git history. Install Git LFS before the first commit that includes it.
*.pt filter=lfs diff=lfs merge=lfs -text

# Keep shell scripts and source files stable across Ubuntu/Windows checkouts.
*.sh text eol=lf
*.py text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.xml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

